# ==========================================================
# APLICACIÓN
# ==========================================================

APP_NAME=MicroplastIA API
API_V1_PREFIX=/api/v1

ENVIRONMENT=development
DEBUG=false

DOCS_ENABLED=true

LOG_LEVEL=INFO


# ==========================================================
# BASE DE DATOS
# ==========================================================

# Desarrollo local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microplastia_db

# Producción:
# Utilizar la cadena de conexión real de Supabase PostgreSQL.
# Nunca subir credenciales reales al repositorio.


# ==========================================================
# JWT
# ==========================================================

# Debe tener al menos 32 caracteres.
# En producción generar una clave aleatoria segura.

SECRET_KEY=reemplaza-esta-clave-por-una-clave-segura-de-al-menos-32-caracteres

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================================
# CORS
# ==========================================================

# Separar múltiples dominios con comas.

# Desarrollo:
ALLOWED_ORIGINS=http://localhost:4200

# Ejemplo producción:
# ALLOWED_ORIGINS=https://microplastia-admin.vercel.app


# ==========================================================
# TRUSTED HOSTS
# ==========================================================

# Desarrollo:
ALLOWED_HOSTS=localhost,127.0.0.1

# Ejemplo producción:
# ALLOWED_HOSTS=microplastia-api.onrender.com


# ==========================================================
# LOGIN / RATE LIMIT
# ==========================================================

LOGIN_MAX_ATTEMPTS=5

LOGIN_ATTEMPT_WINDOW_MINUTES=15

LOGIN_BLOCK_MINUTES=15


# ==========================================================
# MODELO IA
# ==========================================================

MODEL_PATH=weights/best.pt

CONFIDENCE_THRESHOLD=0.25


# ==========================================================
# ARCHIVOS
# ==========================================================

UPLOAD_DIR=uploads

STATIC_DIR=static

MAX_UPLOAD_MB=10

PUBLIC_BASE_URL=


# ==========================================================
# STORAGE
# ==========================================================

# local:
# guarda imágenes en backend/static/
#
# supabase:
# guarda imágenes en Supabase Storage

STORAGE_BACKEND=local

STORAGE_JPEG_QUALITY=90


# ==========================================================
# SUPABASE STORAGE
# ==========================================================

# Solo son necesarios cuando:
#
# STORAGE_BACKEND=supabase
#
# No colocar claves reales en GitHub.

SUPABASE_URL=

SUPABASE_SECRET_KEY=

SUPABASE_STORAGE_BUCKET=microplastia-images