APP_NAME=MicroplastIA API
API_V1_PREFIX=/api/v1
DEBUG=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microplastia_db

SECRET_KEY=cambia-esta-clave-en-tu-archivo-.env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Inferencia YOLOv8n (ruta relativa a la carpeta backend/)
MODEL_PATH=weights/best.pt
CONFIDENCE_THRESHOLD=0.25
UPLOAD_DIR=uploads
STATIC_DIR=static
